rules_version = '2';

// ══════════════════════════════════════════════════════════════════
// FIREBASE STORAGE RULES — MERGED for both:
//   1. SKINARIO Community App (skinario.app)
//   2. SKINARIO-OS Clinic Admin (skinario-os.vercel.app)
//
// Both apps share the same Firebase project (skinario-369).
// ══════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════
    // SKINARIO COMMUNITY APP PATHS
    // ═══════════════════════════════════════════════════════════════

    // ── Forum & Case post images ──
    match /images/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Cover images for articles, resources, events, ads ──
    match /covers/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Video thumbnails ──
    match /videos/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── News images ──
    match /news/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── User content submissions ──
    match /submissions/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Reward catalog images ──
    match /rewards/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── AI-generated Instagram post images for quizzes ──
    match /quiz-ig-images/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── User profile avatars (owner only) ──
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Article inline block images ──
    match /article-blocks/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Forum post inline block images ──
    match /forum-blocks/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Product listing images ──
    match /products/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Sponsor placement logos/banners ──
    match /sponsor-placements/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Wall posts (institute & personal profile) ──
    match /wallPosts/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Certificate logos (admin uploads) ──
    match /certLogos/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ═══════════════════════════════════════════════════════════════
    // SKINARIO-OS CLINIC ADMIN PATHS
    // ═══════════════════════════════════════════════════════════════

    // ── Clinic receipts/bills (Finance module) ──
    match /clinics/{clinicId}/receipts/{fileName} {
      allow read, write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/clinics/$(clinicId)/staff/$(request.auth.uid));
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }

    // ── SKINARIO-OS ad images (Developer panel) ──
    match /ads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email in ['drjpatil@gmail.com', 'absoluteinstituteedu@gmail.com'] &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // ═══ DEFAULT DENY ═══
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
